# Shared
POSTGRES_DB=platformdb
POSTGRES_USER=platformuser
POSTGRES_PASSWORD=platformpass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://platformuser:platformpass@postgres:5432/platformdb
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django
JWT_SIGNING_KEY=replace-with-long-random-string

# Redis (optional)
REDIS_URL=redis://redis:6379/0

# Django superuser bootstrap (optional)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=ChangeMe123!
